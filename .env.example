# Copier ce fichier en ".env" et adapter les valeurs.
# Le fichier .env ne doit JAMAIS etre versionne (il est dans .gitignore).

# Environnement : development ou production
FLASK_ENV=development

# Cle secrete : generer une valeur aleatoire en production, par ex. :
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-cle-en-production

# --- Base de donnees MySQL / MariaDB (phpMyAdmin) ---
# Identifiants par defaut d'une installation locale XAMPP / WAMP / Laragon.
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cas_cliniques

# Alternative : tout definir d'un coup (prioritaire sur les variables ci-dessus)
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/cas_cliniques?charset=utf8mb4
